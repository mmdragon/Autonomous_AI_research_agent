# Copy to backend/.env and frontend/.env.local as needed. No real credentials go here.

# --- Backend (backend/.env) ---
DATABASE_PATH=./data/research.sqlite3
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000"]

# Only "mock" is implemented. No paid model API is called.
LLM_PROVIDER=mock
# fixtures = replay recorded API responses (offline); live = call Wikipedia / Hacker News
SOURCES_MODE=fixtures
# Recorded responses replayed in fixtures mode (see scripts/record_fixtures.py)
FIXTURES_DIR=./fixtures/http

# Wikimedia API etiquette requires a descriptive User-Agent with a way to contact you.
# Required before using SOURCES_MODE=live. Example format:
# HTTP_USER_AGENT=research-agent-local/0.1 (https://github.com/<you>/research-agent; <contact>)
HTTP_USER_AGENT=research-agent-local/0.1 (contact not configured)
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
# Minimum seconds between requests to the same host
HTTP_MIN_INTERVAL_SECONDS=1.0

# Workflow limits
MAX_STEPS_PER_RUN=12
MAX_SOURCES_PER_QUESTION=5
MAX_SOURCES_PER_RUN=25
MAX_RUN_SECONDS=300
MAX_TOOL_CALLS_PER_RUN=60
MAX_FETCH_BYTES=2097152
# Uploaded .txt/.md documents (1 MB)
MAX_UPLOAD_BYTES=1048576

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
